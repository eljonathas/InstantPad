<ResourceDictionary
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:InstantPad.Desktop.Converters">

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:HexToBrushConverter x:Key="HexToBrush"/>
        <converters:ContrastBrushConverter x:Key="ContrastBrush"/>

        <SolidColorBrush x:Key="Amber" Color="#FFB03A"/>
        <SolidColorBrush x:Key="Accent" Color="#FFB03A"/>
        <SolidColorBrush x:Key="Lcd" Color="#7DFFA0"/>
        <SolidColorBrush x:Key="LcdDim" Color="#3F8F5A"/>
        <SolidColorBrush x:Key="SilkScreen" Color="#A6A9B0"/>
        <SolidColorBrush x:Key="ScreenBack" Color="#0B0D11"/>
        <SolidColorBrush x:Key="ScreenLine" Color="#2A2E36"/>
        <FontFamily x:Key="Mono">Consolas</FontFamily>

        <LinearGradientBrush x:Key="Chassis" StartPoint="0,0" EndPoint="0.4,1">
            <GradientStop Color="#34363D" Offset="0"/>
            <GradientStop Color="#232429" Offset="0.45"/>
            <GradientStop Color="#17181C" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Rubber" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#34363C" Offset="0"/>
            <GradientStop Color="#1F2024" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Sheen" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#33FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.45"/>
        </LinearGradientBrush>

        <Style x:Key="Silk" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SilkScreen}"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DialogLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ScreenText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Lcd}"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Backlit rubber pad -->
        <Style x:Key="Pad" TargetType="Button">
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow" CornerRadius="12" Margin="-3" Visibility="Collapsed"
                                    Background="{Binding Color, Converter={StaticResource HexToBrush}}">
                                <Border.Effect>
                                    <BlurEffect Radius="16"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Body" CornerRadius="11" Background="{StaticResource Rubber}"
                                    BorderBrush="#0A0A0C" BorderThickness="2">
                                <Grid>
                                    <Border x:Name="Light" CornerRadius="8" Margin="2" Opacity="0"
                                            Background="{Binding Color, Converter={StaticResource HexToBrush}}"/>
                                    <Border CornerRadius="8" Margin="2" Background="{StaticResource Sheen}"/>
                                    <TextBlock x:Name="SlotLabel" Text="{Binding Label}" Margin="8,5,0,0"
                                               FontFamily="{StaticResource Mono}" FontSize="11" Foreground="#6C7078"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="ShortcutLabel" Text="{Binding Shortcut}" Margin="0,5,8,0"
                                               FontFamily="{StaticResource Mono}" FontSize="10" Foreground="#6C7078"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="FavoriteMark" Text="★" Margin="0,0,7,3" Visibility="Collapsed"
                                               FontSize="14" Foreground="#FFD21F"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" Margin="8,20,8,8"
                                               Foreground="White" FontFamily="Segoe UI Semibold" FontSize="13"
                                               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasSound}" Value="True">
                                <Setter TargetName="Light" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="SlotLabel" Property="Foreground" Value="#E8E8EA"/>
                                <Setter TargetName="ShortcutLabel" Property="Foreground" Value="#FFE0B0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter TargetName="FavoriteMark" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="Light" Property="Opacity" Value="1"/>
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Body" Property="BorderBrush" Value="#EEFFFFFF"/>
                                <Setter TargetName="NameText" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="NameText" Property="Foreground"
                                        Value="{Binding Color, Converter={StaticResource ContrastBrush}}"/>
                                <Setter TargetName="SlotLabel" Property="Foreground"
                                        Value="{Binding Color, Converter={StaticResource ContrastBrush}}"/>
                                <Setter TargetName="ShortcutLabel" Property="Foreground"
                                        Value="{Binding Color, Converter={StaticResource ContrastBrush}}"/>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small hardware key with a LED strip, used for banks, tabs and toggles -->
        <Style x:Key="HwToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#D8DAE0"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Body" CornerRadius="5" BorderBrush="#0A0A0C" BorderThickness="1"
                                Background="{StaticResource Rubber}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Border x:Name="Led" Height="3" Margin="10,3,10,0" CornerRadius="1.5" Background="#2B2D32"/>
                                <ContentPresenter Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Led" Property="Background" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#141518"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HwButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#D8DAE0"/>
            <Setter Property="Background" Value="{StaticResource Rubber}"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" CornerRadius="5" BorderBrush="#0A0A0C" BorderThickness="1"
                                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="#5A5E68"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#050608"/>
            <Setter Property="Foreground" Value="{StaticResource Lcd}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Lcd}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ScreenLine}"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Lcd}"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#050608" BorderBrush="{StaticResource ScreenLine}" BorderThickness="1">
                                            <TextBlock Text="▾" Foreground="{StaticResource Lcd}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                              Margin="8,5,22,5" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="None" Focusable="False">
                                <Border Background="#0B0D11" BorderBrush="{StaticResource LcdDim}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource Lcd}"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#1D3A28"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#3F8F5A" CornerRadius="3" Margin="1,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

</ResourceDictionary>
