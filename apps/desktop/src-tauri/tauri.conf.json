{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InstantPad",
  "version": "0.0.0",
  "identifier": "com.eljonathas.instantpad",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "InstantPad",
        "width": 1320,
        "height": 800,
        "minWidth": 880,
        "minHeight": 533,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "PortugueseBR"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "mainBinaryName": "InstantPad",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3QjU5RUQzQUNGMDYyNTIKUldSU1l2Q3MwNTYxNTZiRjEva3l5ZHZIayt6WHJKMVJramNxVGI4RGNvM21RR0JuTUNYRm9Rd0cK",
      "endpoints": [
        "https://github.com/eljonathas/InstantPad/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
